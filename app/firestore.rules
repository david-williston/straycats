rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // Admins can read, never write, other people's data.
    function canRead(uid) {
      return isOwner(uid) || isAdmin();
    }

    function isNickname(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    function isId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function isCat() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'updatedAt'])
        && d.keys().hasAll(['name', 'updatedAt'])
        && d.name is string
        && d.name.size() <= 100
        && d.updatedAt == request.time;
    }

    // A list of at most as many items as there are allowed values, each one allowed.
    function isListOf(list, allowed) {
      return list is list
        && list.size() <= allowed.size()
        && list.hasOnly(allowed);
    }

    function isEncounter(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['catId', 'photoId', 'takenAt', 'activity', 'conditions', 'care', 'note', 'updatedAt'])
        && d.keys().hasAll(['catId', 'takenAt', 'updatedAt'])
        && isId(d.catId)
        && existsAfter(/databases/$(database)/documents/users/$(uid)/cats/$(d.catId))
        && (!('photoId' in d) || isId(d.photoId))
        && d.takenAt is timestamp
        && d.takenAt > timestamp.date(2000, 1, 1)
        && d.takenAt < request.time + duration.value(1, 'd')
        && (!('activity' in d) || d.activity in ['eating', 'sleeping', 'resting', 'waiting_at_door', 'playing', 'walking_by'])
        && (!('conditions' in d) || isListOf(d.conditions, ['healthy', 'thin', 'limping', 'unwell_or_injured', 'with_kittens', 'ear_tipped']))
        && (!('care' in d) || isListOf(d.care, ['fed', 'gave_water', 'took_to_vet', 'gave_medicine']))
        && (!('note' in d) || (d.note is string && d.note.size() <= 1000))
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if canRead(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['createdAt', 'nickname'])
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.createdAt == request.time
        && (!('nickname' in request.resource.data) || isNickname(request.resource.data.nickname));
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['createdAt', 'nickname'])
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('nickname' in request.resource.data) || isNickname(request.resource.data.nickname));
      // No client deletes.
    }

    // Roles are written only by the Admin SDK (tools/roles/set-role.mjs).
    match /roles/{uid} {
      allow read: if canRead(uid);
      match /history/{id} {
        allow read: if canRead(uid);
      }
    }

    match /users/{uid}/cats/{catId} {
      allow read: if canRead(uid);
      allow create, update: if isOwner(uid) && isId(catId) && isCat();
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/encounters/{encounterId} {
      allow read: if canRead(uid);
      allow create, update: if isOwner(uid) && isId(encounterId) && isEncounter(uid);
      allow delete: if isOwner(uid);
    }
  }
}
