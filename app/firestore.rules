rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // Admins can read, never write, other people's data.
    function canRead(uid) {
      return isOwner(uid) || isAdmin();
    }

    function isNickname(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    function isId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function isCat() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'updatedAt'])
        && d.keys().hasAll(['name', 'updatedAt'])
        && d.name is string
        && d.name.size() <= 100
        && d.updatedAt == request.time;
    }

    // A list of at most as many items as there are allowed values, each one allowed.
    function isListOf(list, allowed) {
      return list is list
        && list.size() <= allowed.size()
        && list.hasOnly(allowed);
    }

    function isEncounter(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['catId', 'photoId', 'takenAt', 'activity', 'conditions', 'care', 'note', 'area', 'neighbourhood', 'updatedAt'])
        && d.keys().hasAll(['catId', 'takenAt', 'updatedAt'])
        && isId(d.catId)
        && existsAfter(/databases/$(database)/documents/users/$(uid)/cats/$(d.catId))
        && (!('photoId' in d) || isId(d.photoId))
        && d.takenAt is timestamp
        && d.takenAt > timestamp.date(2000, 1, 1)
        && d.takenAt < request.time + duration.value(1, 'd')
        && (!('activity' in d) || d.activity in ['eating', 'sleeping', 'resting', 'waiting_at_door', 'playing', 'walking_by'])
        && (!('conditions' in d) || isListOf(d.conditions, ['healthy', 'thin', 'limping', 'unwell_or_injured', 'with_kittens', 'ear_tipped']))
        && (!('care' in d) || isListOf(d.care, ['fed', 'gave_water', 'took_to_vet', 'gave_medicine']))
        && (!('note' in d) || (d.note is string && d.note.size() <= 1000))
        // A geohash of exactly 6 characters (about 1.2 x 0.6 km), never a point.
        && (!('area' in d) || (d.area is string && d.area.matches('^[0-9b-hjkmnp-z]{6}$')))
        && (!('neighbourhood' in d) || (d.neighbourhood is string && d.neighbourhood.size() <= 80))
        && d.updatedAt == request.time;
    }

    // "YYYY", "YYYY-MM" or "YYYY-MM-DD", from 1980, the year not in the future.
    // `around` only goes with a bare year. Month and day are checked in the app.
    function isPartialDate(d) {
      return d.on is string
        && d.on.matches('^(19[89][0-9]|20[0-9]{2})(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$')
        && int(d.on.split('-')[0]) <= request.time.year()
        && (!('around' in d) || (d.around is bool && (!d.around || d.on.size() == 4)));
    }

    // A life event in a cat's story. Once-only types are not enforced here:
    // duplicates are meant to be visible, not refused. A place, if any, is only
    // a 6-character geohash and a neighbourhood name, never a point.
    function isEvent(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['catId', 'type', 'on', 'around', 'note', 'area', 'neighbourhood', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['catId', 'type', 'on', 'createdAt', 'updatedAt'])
        && isId(d.catId)
        && existsAfter(/databases/$(database)/documents/users/$(uid)/cats/$(d.catId))
        && d.type in ['born', 'missing', 'found', 'sterilised', 'died']
        && isPartialDate(d)
        && (!('note' in d) || (d.note is string && d.note.size() <= 1000))
        && (!('area' in d) || (d.area is string && d.area.matches('^[0-9b-hjkmnp-z]{6}$')))
        && (!('neighbourhood' in d) || (d.neighbourhood is string && d.neighbourhood.size() <= 80))
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if canRead(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['createdAt', 'nickname'])
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.createdAt == request.time
        && (!('nickname' in request.resource.data) || isNickname(request.resource.data.nickname));
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['createdAt', 'nickname'])
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('nickname' in request.resource.data) || isNickname(request.resource.data.nickname));
      // No client deletes.
    }

    // Roles are written only by the Admin SDK (tools/roles/set-role.mjs).
    match /roles/{uid} {
      allow read: if canRead(uid);
      match /history/{id} {
        allow read: if canRead(uid);
      }
    }

    match /users/{uid}/cats/{catId} {
      allow read: if canRead(uid);
      allow create, update: if isOwner(uid) && isId(catId) && isCat();
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/encounters/{encounterId} {
      allow read: if canRead(uid);
      allow create, update: if isOwner(uid) && isId(encounterId) && isEncounter(uid);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/events/{eventId} {
      allow read: if canRead(uid);
      allow create: if isOwner(uid) && isId(eventId) && isEvent(uid)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && isEvent(uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }
  }
}
